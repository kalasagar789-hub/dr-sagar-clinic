# Copy this file to .env only if your deployment tool loads environment files.
# Never commit the real .env file.
CLINIC_ENV=production
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://clinic_user:strong-password@db-host:5432/clinic_db
PUBLIC_BASE_URL=https://clinic.example.com
SESSION_COOKIE_SECURE=true

# Explicitly enable these only during first controlled database setup.
CLINIC_AUTO_CREATE_SCHEMA=false
CLINIC_BOOTSTRAP_REFERENCE_DATA=false

# Patient OTP must be implemented through a verified SMS provider before go-live.
# DEMO_PATIENT_OTP=
